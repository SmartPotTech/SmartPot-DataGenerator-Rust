# Broker: en local sin TLS; contra producción usa mqtt.smartpot.app, 8883, TLS y la CA pública.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_CA_FILE=
MQTT_TOPIC_PREFIX=smartpot/v1

# Dispositivos a simular: cropId:clave:TIPO separadas por comas.
# La clave es la del dispositivo que entrega la API al crear el cultivo o al rotarla.
SIMULATOR_DEVICES=66f5a1000000000000000101:demo-lettuce-device-key-2026:LETTUCE,66f5a1000000000000000102:demo-tomato-device-key-2026:TOMATO
SIMULATOR_INTERVAL_SECONDS=30
SIMULATOR_UTC_OFFSET=-5
RUST_LOG=info

# API interna de control de cultivos virtuales (la usa SmartPot-API). Mínimo 24 caracteres; vacío la deshabilita.
SIMULATOR_TOKEN=
SIMULATOR_PORT=8081
